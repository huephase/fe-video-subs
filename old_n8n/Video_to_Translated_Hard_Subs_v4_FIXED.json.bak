      ],
      "id": "2331a955-4f45-49e4-81d9-5ee012f47def",
      "name": "MAIN VARIABLES"
    },
    {
      "parameters": {
        "command": "=echo \"Checking generated files in {{ $('Build automated paths').item.json.jobDir }}\" && \\\nls -lah \"{{ $('Build automated paths').item.json.jobDir }}\" && \\\ntest -s \"{{ $('Build automated paths').item.json.englishSrt }}\" && \\\ntest -s \"{{ $('Build automated paths').item.json.translatedSrt }}\" && \\\ntest -s \"{{ $('Build automated paths').item.json.assPath }}\" && \\\necho \"ASS subtitle exists: {{ $('Build automated paths').item.json.assPath }}\" "
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1328,
        320
      ],
      "id": "03aedcaf-98a4-49c5-80ac-cadc21b49b20",
      "name": "Execute Command: Verify subtitle files"
    },
    {
      "parameters": {
        "command": "=ffmpeg -y \\\n  -i \"{{ $('Build automated paths').item.json.inputVideo }}\" \\\n  -vf \"ass={{ $('Build automated paths').item.json.assPath }}\" \\\n  -c:v libx264 \\\n  -preset veryfast \\\n  -crf 20 \\\n  -c:a copy \\\n  \"{{ $('Build automated paths').item.json.outputVideo }}\" "
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
